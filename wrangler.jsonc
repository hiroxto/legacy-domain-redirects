{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legacy-domain-redirects",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "routes": [
    {
      "pattern": "www.hiroxto.net",
      "custom_domain": true
    },
    {
      "pattern": "swarm-checkin-regulation-checker.hiroxto.net",
      "custom_domain": true
    },
    {
      "pattern": "fare-ticket-route-planning.hiroxto.net",
      "custom_domain": true
    },
    {
      "pattern": "utils.hiroxto.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
